            "listen": "test",
            "script": { "exec": ["pm.test('201',()=>pm.response.to.have.status(201));"], "type": "text/javascript" }
          }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"{{catName}}\"}" }, "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } }
        },
        {
          "name": "Non-Admin — 403",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403',()=>pm.response.to.have.status(403));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{mentee_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Hack\"}" }, "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } }
        }
      ]
    },
    {
      "name": "4. Mentors",
      "item": [
        { "name": "List (Public)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));","var d=pm.response.json().data;if(d&&d.length)pm.collectionVariables.set('mentorId',d[0].id);"], "type": "text/javascript" } }], "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/mentors", "host": ["{{base_url}}"], "path": ["mentors"] } } },
        { "name": "Get by ID", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }], "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/mentors/{{mentorId}}", "host": ["{{base_url}}"], "path": ["mentors","{{mentorId}}"] } } },
        { "name": "Approve (Admin)", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 or 201',()=>pm.expect(pm.response.code).to.be.oneOf([200,201]));"], "type": "text/javascript" } }], "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": { "raw": "{{base_url}}/mentors/{{mentorId}}/approve", "host": ["{{base_url}}"], "path": ["mentors","{{mentorId}}","approve"] } } }
      ]
    },
    {
      "name": "5. Mentees",
