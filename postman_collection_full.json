        { "name": "No Auth — 401", "event": [{ "listen": "test", "script": { "exec": ["pm.test('401',()=>pm.response.to.have.status(401));"], "type": "text/javascript" } }], "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/mentees", "host": ["{{base_url}}"], "path": ["mentees"] } } }
      ]
