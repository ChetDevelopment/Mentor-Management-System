            "header": [{ "key": "Authorization", "value": "Bearer {{mentee_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"mentorId\":\"{{mentorId}}\",\"menteeId\":\"{{menteeId}}\",\"rating\":5,\"comment\":\"Great mentor!\"}" },
            "url": { "raw": "{{base_url}}/feedback", "host": ["{{base_url}}"], "path": ["feedback"] }
          }
        },
        {
          "name": "Get Feedback by Mentor",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": { "raw": "{{base_url}}/feedback/mentor/{{mentorId}}", "host": ["{{base_url}}"], "path": ["feedback", "mentor", "{{mentorId}}"] }
          }
        }
      ]
    },
    {
      "name": "13. Admin",
      "item": [
        {
          "name": "Dashboard",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Has stats', () => pm.expect(pm.response.json().data).to.have.property('totalUsers'));"], "type": "text/javascript" } }],
          "request": {
