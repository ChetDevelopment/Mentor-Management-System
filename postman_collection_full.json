        { "name": "List", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": { "raw": "{{base_url}}/notifications", "host": ["{{base_url}}"], "path": ["notifications"] } } },
        { "name": "Unread", "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": { "raw": "{{base_url}}/notifications/unread", "host": ["{{base_url}}"], "path": ["notifications","unread"] } } }
