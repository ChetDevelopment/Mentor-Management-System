{
  "info": {
    "name": "Mentor Management API — Render Deployed",
    "description": "Tests all endpoints. URL: https://mentor-management-api.onrender.com/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "https://mentor-management-api.onrender.com/api/v1" },
    { "key": "admin_token", "value": "" },
    { "key": "mentor_token", "value": "" },
    { "key": "mentee_token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "mentorId", "value": "" },
    { "key": "menteeId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "skillId", "value": "" },
    { "key": "skillName", "value": "" },
    { "key": "catName", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth — Run First",
      "item": [
        {
          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": { "exec": ["var d=pm.response.json().data;pm.collectionVariables.set('admin_token',d.accessToken);pm.collectionVariables.set('userId',d.user.id);pm.test('201',()=>pm.response.to.have.status(201));"], "type": "text/javascript" }
          }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"admin@mentorkhet.test\",\"password\":\"Password123!\"}" }, "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] } }
        },
        {
          "name": "Login Mentor",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json().data;pm.collectionVariables.set('mentor_token',d.accessToken);pm.test('201',()=>pm.response.to.have.status(201));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"sophea.mentor@mentorkhet.test\",\"password\":\"Password123!\"}" }, "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] } }
        },
        {
          "name": "Login Mentee",
          "event": [{ "listen": "test", "script": { "exec": ["var d=pm.response.json().data;pm.collectionVariables.set('mentee_token',d.accessToken);pm.test('201',()=>pm.response.to.have.status(201));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"nita.mentee@mentorkhet.test\",\"password\":\"Password123!\"}" }, "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] } }
        },
        {
          "name": "Login — Wrong Password (401)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('401',()=>pm.response.to.have.status(401));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"admin@mentorkhet.test\",\"password\":\"WrongPass1234!\"}" }, "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth","login"] } }
        },
        {
          "name": "Register (201)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('201',()=>pm.response.to.have.status(201));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\":\"user{{$randomInt}}@test.com\",\"password\":\"Password123!\",\"firstName\":\"Test\",\"lastName\":\"User\",\"role\":\"mentee\"}" }, "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth","register"] } }
        }
      ]
    },
    {
      "name": "1. Health",
      "item": [{
        "name": "Health Check",
        "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));pm.test('ok',()=>pm.response.json().data.status==='ok');"], "type": "text/javascript" } }],
        "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] } }
      }]
    },
    {
      "name": "2. Skills",
      "item": [
        {
          "name": "List (Public)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/skills", "host": ["{{base_url}}"], "path": ["skills"] } }
        },
        {
          "name": "Create (Admin)",
          "event": [{
            "listen": "prerequest",
            "script": { "exec": ["pm.collectionVariables.set('skillName','Skill'+Date.now());"], "type": "text/javascript" }
          }, {
            "listen": "test",
            "script": { "exec": ["pm.test('201',()=>pm.response.to.have.status(201));","var d=pm.response.json().data;if(d)pm.collectionVariables.set('skillId',d.id);"], "type": "text/javascript" }
          }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"{{skillName}}\"}" }, "url": { "raw": "{{base_url}}/skills", "host": ["{{base_url}}"], "path": ["skills"] } }
        },
        {
          "name": "Duplicate — 400",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400',()=>pm.response.to.have.status(400));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"{{skillName}}\"}" }, "url": { "raw": "{{base_url}}/skills", "host": ["{{base_url}}"], "path": ["skills"] } }
        },
        {
          "name": "Non-Admin — 403",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403',()=>pm.response.to.have.status(403));"], "type": "text/javascript" } }],
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{mentee_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Rust\"}" }, "url": { "raw": "{{base_url}}/skills", "host": ["{{base_url}}"], "path": ["skills"] } }
        },
        {
          "name": "Get by ID",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/skills/{{skillId}}", "host": ["{{base_url}}"], "path": ["skills","{{skillId}}"] } }
        },
        {
          "name": "Not Found — 404",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404',()=>pm.response.to.have.status(404));"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/skills/00000000-0000-0000-0000-000000000000", "host": ["{{base_url}}"], "path": ["skills","00000000-0000-0000-0000-000000000000"] } }
        },
        {
          "name": "Update (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"name\":\"Updated\"}" }, "url": { "raw": "{{base_url}}/skills/{{skillId}}", "host": ["{{base_url}}"], "path": ["skills","{{skillId}}"] } }
        },
        {
          "name": "Delete (Admin)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));"], "type": "text/javascript" } }],
          "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }], "url": { "raw": "{{base_url}}/skills/{{skillId}}", "host": ["{{base_url}}"], "path": ["skills","{{skillId}}"] } }
        }
      ]
    },
    {
      "name": "3. Categories",
      "item": [
        {
          "name": "List (Public)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200',()=>pm.response.to.have.status(200));","var d=pm.response.json().data;if(d&&d.length)pm.collectionVariables.set('categoryId',d[0].id);"], "type": "text/javascript" } }],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/categories", "host": ["{{base_url}}"], "path": ["categories"] } }
        },
        {
          "name": "Create (Admin)",
          "event": [{
            "listen": "prerequest",
