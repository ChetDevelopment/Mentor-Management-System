  },
  "variable": [
    { "key": "base_url", "value": "https://mentor-management-api.onrender.com/api/v1" },
    { "key": "admin_token", "value": "" },
    { "key": "mentor_token", "value": "" },
    { "key": "mentee_token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "mentorId", "value": "" },
    { "key": "menteeId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "skillId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Auth (Run First)",
      "item": [
        {
          "name": "Login Admin",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json().data;",
                "pm.collectionVariables.set('admin_token', d.accessToken);",
                "pm.collectionVariables.set('userId', d.user.id);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.test('Has token', () => pm.expect(d.accessToken).to.be.a('string'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"admin@mentorkhet.test\",\"password\":\"Password123!\"}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Mentor",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json().data;",
                "pm.collectionVariables.set('mentor_token', d.accessToken);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"sophea.mentor@mentorkhet.test\",\"password\":\"Password123!\"}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Mentee",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "var d = pm.response.json().data;",
                "pm.collectionVariables.set('mentee_token', d.accessToken);",
                "pm.test('Status 201', () => pm.response.to.have.status(201));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"nita.mentee@mentorkhet.test\",\"password\":\"Password123!\"}" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
