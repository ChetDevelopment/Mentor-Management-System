# ============================================================
# Mentor Management System — Environment Configuration
# ============================================================

# Database — Use DATABASE_URL (PostgreSQL) for cloud (Neon, Supabase, Render)
# Or use individual fields below for local PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Or use individual connection fields (local PostgreSQL):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=your_password
# DB_DATABASE=mentor_management

# JWT
JWT_SECRET=CHANGE_ME_TO_128_CHAR_HEX_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Application
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
