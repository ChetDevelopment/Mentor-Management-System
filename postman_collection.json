{
  "info": {
    "name": "Mentor Management System",
    "description": "Complete API collection for Mentor Management System\n\nBase URL: {{base_url}}\nAuth: Use {{token}} variable (set via Login/Register responses)\n\n== FLOW ==\n1. Register/Login as admin → copy token to {{token}}\n2. Test public endpoints\n3. Test admin, mentor, mentee endpoints with appropriate tokens",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000/api/v1" },
    { "key": "token", "value": "" },
    { "key": "admin_token", "value": "" },
    { "key": "mentor_token", "value": "" },
    { "key": "mentee_token", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "mentorId", "value": "" },
    { "key": "menteeId", "value": "" },
    { "key": "sessionId", "value": "" },
    { "key": "feedbackId", "value": "" },
    { "key": "skillId", "value": "" },
    { "key": "categoryId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        { "name": "Check Health", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] } } }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["var jsonData = pm.response.json();", "if (jsonData.data) {", "  pm.collectionVariables.set('admin_token', jsonData.data.accessToken);", "  pm.collectionVariables.set('token', jsonData.data.accessToken);", "}"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Pass123!\",\n  \"firstName\": \"Admin\",\n  \"lastName\": \"User\",\n  \"role\": \"admin\"\n}"},
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Mentor",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["var jsonData = pm.response.json();", "if (jsonData.data) {", "  pm.collectionVariables.set('mentor_token', jsonData.data.accessToken);", "}"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"mentor@test.com\",\n  \"password\": \"Pass123!\",\n  \"firstName\": \"Mentor\",\n  \"lastName\": \"User\",\n  \"role\": \"mentor\"\n}"},
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Register Mentee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["var jsonData = pm.response.json();", "if (jsonData.data) {", "  pm.collectionVariables.set('mentee_token', jsonData.data.accessToken);", "  pm.collectionVariables.set('userId', jsonData.data.user.id);", "}"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"mentee@test.com\",\n  \"password\": \"Pass123!\",\n  \"firstName\": \"Mentee\",\n  \"lastName\": \"User\",\n  \"role\": \"mentee\"\n}"},
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["var jsonData = pm.response.json();", "if (jsonData.data) {", "  pm.collectionVariables.set('token', jsonData.data.accessToken);", "  pm.collectionVariables.set('userId', jsonData.data.user.id);", "}"],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"Pass123!\"\n}"},
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        { "name": "Forgot Password", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"admin@test.com\"\n}"}, "url": { "raw": "{{base_url}}/auth/forgot-password", "host": ["{{base_url}}"], "path": ["auth", "forgot-password"] } } },
        { "name": "Reset Password", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"token\": \"<reset_token_from_forgot_password>\",\n  \"password\": \"NewPass123!\"\n}"}, "url": { "raw": "{{base_url}}/auth/reset-password", "host": ["{{base_url}}"], "path": ["auth", "reset-password"] } } },
        { "name": "Verify Email", "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/auth/verify-email?token=<verification_token>", "host": ["{{base_url}}"], "path": ["auth", "verify-email"], "query": [{"key": "token", "value": "<verification_token>"}] } } },
        { "name": "Resend Verification", "request": { "method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\n  \"email\": \"mentor@test.com\"\n}"}, "url": { "raw": "{{base_url}}/auth/resend-verification", "host": ["{{base_url}}"], "path": ["auth", "resend-verification"] } } },
        {
          "name": "Logout",
          "request": {
            "method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": { "raw": "{{base_url}}/auth/refresh-token", "host": ["{{base_url}}"], "path": ["auth", "refresh-token"] }
          }
        }
      ]
    },
