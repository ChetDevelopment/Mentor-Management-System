        { "name": "Update Mentor", "request": { "method": "PUT", "url": "{{baseUrl}}/mentors/:id", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"title\": \"Lead Engineer\"}"} } },
        { "name": "Reject Mentor", "request": { "method": "POST", "url": "{{baseUrl}}/mentors/:id/reject", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"reason\": \"Insufficient experience\"}"} } },
