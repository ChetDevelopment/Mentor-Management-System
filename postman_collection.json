        { "name": "Get User By ID (Admin)", "request": { "method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{admin_token}}"}], "url": { "raw": "{{base_url}}/users/{{userId}}", "host": ["{{base_url}}"], "path": ["users", "{{userId}}"] } } },
