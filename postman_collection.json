{
  "info": {
    "name": "MentorKhet API",
    "description": "Mentor-Mentee Matching Platform API Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        { "name": "Register", "request": { "method": "POST", "url": "{{baseUrl}}/auth/register", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\": \"user@example.com\", \"password\": \"password123\", \"firstName\": \"John\", \"lastName\": \"Doe\", \"role\": \"mentee\"}"} } },
        { "name": "Login", "request": { "method": "POST", "url": "{{baseUrl}}/auth/login", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\": \"admin@mentorkhet.com\", \"password\": \"password123\"}"} }, "event": [ { "listen": "test", "script": { "exec": [ "var jsonData = JSON.parse(responseBody);", "if (jsonData.accessToken) {", "  pm.collectionVariables.set('token', jsonData.accessToken);", "  pm.environment.set('token', jsonData.accessToken);", "}" ], "type": "text/javascript" } } ] },
        { "name": "Logout", "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}] } },
        { "name": "Refresh Token", "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh-token", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}] } },
        { "name": "Forgot Password", "request": { "method": "POST", "url": "{{baseUrl}}/auth/forgot-password", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\": \"admin@mentorkhet.com\"}"} } },
        { "name": "Reset Password", "request": { "method": "POST", "url": "{{baseUrl}}/auth/reset-password", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"token\": \"<reset_token>\", \"password\": \"newPassword123\"}"} } }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "Get Profile", "request": { "method": "GET", "url": "{{baseUrl}}/users/profile", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}] } },
        { "name": "Update Profile", "request": { "method": "PUT", "url": "{{baseUrl}}/users/profile", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"firstName\": \"Updated\", \"phone\": \"012345678\"}"} } },
        { "name": "Get All Users", "request": { "method": "GET", "url": "{{baseUrl}}/users", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}] } },
        { "name": "Get User By ID", "request": { "method": "GET", "url": "{{baseUrl}}/users/:id", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}] } },
        { "name": "Update User", "request": { "method": "PUT", "url": "{{baseUrl}}/users/:id", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"firstName\": \"Updated\"}"} } },
        { "name": "Delete User", "request": { "method": "DELETE", "url": "{{baseUrl}}/users/:id", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}] } }
      ]
    },
